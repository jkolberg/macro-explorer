   "source": [
    "#| output: false\n",
    "import os\n",
    "import yaml\n",
    "import pandas as pd\n",
    "\n",
    "from macro_explorer.util.census_helpers import CensusApi  # noqa: F401  (kept for parity with notebook env)\n",
    "from macro_explorer.steps.get_remi_hh_units import load_remi_pop\n",
    "\n",
    "cfg = yaml.safe_load(open(\"configs/settings.yaml\"))\n",
    "\n",
    "COUNTY_MAP = cfg[\"county_map\"]                       # name -> id\n",
    "ID_TO_COUNTY = {v: k for k, v in COUNTY_MAP.items()}  # id -> name\n",
    "COUNTY_IDS = list(cfg[\"county_ids\"])\n",
    "N_COUNTIES = len(COUNTY_IDS)\n",
    "\n",
    "# Metrics exposed in the dashboard. Additive metrics can be summed for the\n",
    "# region; ratio metrics are recomputed from summed components.\n",
    "ADDITIVE_METRICS = [\"total_pop\", \"units\", \"hh\", \"hhpop\", \"gq\"]\n",
    "METRICS = [\"total_pop\", \"units\", \"hh\", \"hhpop\", \"hhsz\", \"gq\"]\n",
    "\n",
    "\n",
    "# --- Data preparation (ported from forecast_explorer.ipynb) -----------------\n",
    "\n",
    "def clean_growth_targets(cfg):\n",
    "    df_out = pd.DataFrame()\n",
    "    for target in cfg[\"growth_targets\"]:\n",
    "        target_baseyear = target[\"base_year\"]\n",
    "        target_year = target[\"target_year\"]\n",
    "        base_type = target[\"base_type\"]\n",
    "        df = pd.read_csv(os.path.join(cfg[\"data_dir\"], target[\"filename\"]))\n",
    "        df = (\n",
    "            df.groupby(\"county_id\")[\n",
    "                [\n",
    "                    f\"{base_type}_units\",\n",
    "                    f\"units_{target_year}\",\n",
    "                    f\"{base_type}_total_pop\",\n",
    "                    f\"total_pop_{target_year}\",\n",
    "                ]\n",
    "            ]\n",
    "            .sum()\n",
    "            .round(0)\n",
    "            .astype(int)\n",
    "        )\n",
    "        df = df.rename(\n",
    "            columns={\n",
    "                f\"{base_type}_units\": f\"units_{target_baseyear}\",\n",
    "                f\"{base_type}_total_pop\": f\"total_pop_{target_baseyear}\",\n",
    "            }\n",
    "        )\n",
    "        df = (\n",
    "            pd.wide_to_long(\n",
    "                df.reset_index(),\n",
    "                stubnames=[\"units\", \"total_pop\"],\n",
    "                i=\"county_id\",\n",
    "                j=\"year\",\n",
    "                sep=\"_\",\n",
    "            )\n",
    "            .sort_index()\n",
    "            .reset_index()\n",
    "        )\n",
    "        df[\"units\"] = df[\"units\"].replace(0, float(\"nan\"))\n",
    "        df[\"name\"] = target[\"name\"]\n",
    "        df_out = pd.concat([df_out, df], ignore_index=True)\n",
    "    return df_out\n",
    "\n",
    "\n",
    "def clean_ofm(cfg, file_path, ofm_type):\n",
    "    ofm_types = {\"total_pop\": \"Population\", \"units\": \"Housing Units\"}\n",
    "    skip_rows = {\"total_pop\": 4, \"units\": 3}\n",
    "    col_filter = {\"total_pop\": None, \"units\": \"Total Housing Units\"}\n",
    "    df = pd.read_excel(file_path, skiprows=skip_rows[ofm_type], sheet_name=ofm_types[ofm_type])\n",
    "    df[\"county_id\"] = df[\"Jurisdiction\"].map(cfg[\"county_map\"])\n",
    "    df = df.loc[df[\"county_id\"].notna()].copy()\n",
    "    flt = col_filter[ofm_type]\n",
    "    value_cols = [c for c in df.columns if c[:4].isdigit() and (flt is None or flt in c)]\n",
    "    df = df.rename(columns={c: c[:4] for c in value_cols})\n",
    "    year_cols = [str(y) for y in range(2020, 2026)]\n",
    "    ofm = df[[\"county_id\"] + year_cols].melt(id_vars=\"county_id\", var_name=\"year\", value_name=ofm_type)\n",
    "    return ofm\n",
    "\n",
    "\n",
    "def clean_pep(cfg, file_path, pep_type):\n",
    "    df = pd.read_excel(file_path, skiprows=2, header=[0, 1])\n",
    "    year_cols = [str(y) for y in range(2020, 2026)]\n",
    "    df.columns = [\"geog\", \"april2020\"] + year_cols\n",
    "    df[\"county_id\"] = df[\"geog\"].str.lstrip(\".\").str.split(\",\").str[0].map(cfg[\"county_map\"])\n",
    "    df = df.loc[df[\"county_id\"].notna()].copy().set_index(\"county_id\")\n",
    "    return df[year_cols].reset_index().melt(id_vars=\"county_id\", var_name=\"year\", value_name=pep_type)\n",
    "\n",
    "\n",
    "# Growth targets\n",
    "growth_targets = clean_growth_targets(cfg)\n",
    "growth_targets[\"type\"] = \"Growth Target\"\n",
    "\n",
    "# REMI history\n",
    "remi_hist = (\n",
    "    load_remi_pop(f\"{cfg['data_dir']}/{cfg['remi_history_file']}\", cfg[\"county_map\"])\n",
    "    .groupby([\"year\", \"county_id\"], as_index=False)[[\"total_pop\"]]\n",
    "    .sum()\n",
    "    .astype(\"int\")\n",
    "    .assign(name=\"REMI History\", type=\"Historical\")\n",
    ")\n",
    "\n",
    "# OFM (population + housing)\n",
    "ofm_pop = clean_ofm(cfg, os.path.join(cfg[\"data_dir\"], cfg[\"ofm_population_file\"]), \"total_pop\")\n",
    "ofm_housing = clean_ofm(cfg, os.path.join(cfg[\"data_dir\"], cfg[\"ofm_housing_file\"]), \"units\")\n",
    "ofm = ofm_pop.merge(ofm_housing, on=[\"county_id\", \"year\"])\n",
    "ofm[\"year\"] = ofm[\"year\"].astype(int)\n",
    "ofm[\"name\"] = \"OFM\"\n",
    "ofm[\"type\"] = \"Historical\"\n",
    "\n",
    "# PEP (population + housing)\n",
    "pep_pop = clean_pep(cfg, os.path.join(cfg[\"data_dir\"], cfg[\"pep_population_file\"]), \"total_pop\")\n",
    "pep_housing = clean_pep(cfg, os.path.join(cfg[\"data_dir\"], cfg[\"pep_housing_file\"]), \"units\")\n",
    "pep = pep_pop.merge(pep_housing, on=[\"county_id\", \"year\"])\n",
    "pep[\"year\"] = pep[\"year\"].astype(int)\n",
    "pep[\"name\"] = \"PEP\"\n",
    "pep[\"type\"] = \"Historical\"\n",
    "\n",
    "# ACS\n",
    "acs = pd.read_csv(os.path.join(cfg[\"data_dir\"], \"acs_county_totals.csv\"))\n",
    "acs[\"name\"] = \"ACS\"\n",
    "acs_occ = (\n",
    "    acs.sort_values(\"year\", ascending=False)\n",
    "    .drop_duplicates(\"county_id\")\n",
    "    .set_index(\"county_id\")[\"occupancy\"]\n",
    ")\n",
    "acs[\"type\"] = \"Historical\"\n",
    "\n",
    "# Decennial\n",
    "dec = pd.read_csv(f\"{cfg['data_dir']}/decennial_totals.csv\")\n",
    "dec[\"name\"] = \"Decennial\"\n",
    "dec[\"type\"] = \"Historical\"\n",
    "\n",
    "# REMI forecasts\n",
    "remi = pd.read_csv(f\"{cfg['data_dir']}/{cfg['remi_output_file']}\").query('year > @cfg[\"remi_base_year\"]')\n",
    "remi[\"occupancy\"] = remi[\"county_id\"].map(acs_occ)\n",
    "remi[\"units\"] = (remi[\"hh\"] / remi[\"occupancy\"]).round(0).astype(int)\n",
    "remi[\"hhsz\"] = remi[\"hhpop\"] / remi[\"hh\"]\n",
    "remi[\"type\"] = \"Forecast\"\n",
    "\n",
    "df = pd.concat([dec, acs, remi, pep, ofm, remi_hist, growth_targets], ignore_index=True)\n",
    "\n",
    "\n",
    "# --- Build the county + region view -----------------------------------------\n",
    "\n",
    "# Restrict to the four configured counties.\n",
    "county_df = df[df[\"county_id\"].isin(COUNTY_IDS)].copy()\n",
    "county_df[\"geography\"] = county_df[\"county_id\"].map(ID_TO_COUNTY)\n",
    "\n",
    "\n",
    "def build_region(county_df):\n",
    "    \"\"\"Sum additive metrics across the four counties per name/type/year.\n",
    "\n",
    "    A metric is only aggregated to a region value for a source when that source\n",
    "    has complete four-county coverage in EVERY year it reports the metric. If\n",
    "    any reported year is missing one or more counties, the metric is excluded\n",
    "    from the region entirely (all-null) so partial-coverage sources such as\n",
    "    growth_targets_v2021 are never offered or shown as a misleading regional\n",
    "    total. Ratio metrics are recomputed from the summed components.\n",
    "    \"\"\"\n",
    "    # Determine, per (name, metric), whether every reported year is complete.\n",
    "    region_eligible = {}\n",
    "    for name, g_name in county_df.groupby(\"name\"):\n",
    "        for m in ADDITIVE_METRICS:\n",
    "            if m not in g_name:\n",
    "                region_eligible[(name, m)] = False\n",
    "                continue\n",
    "            reported = g_name[g_name[m].notna()]\n",
    "            if reported.empty:\n",
    "                region_eligible[(name, m)] = False\n",
    "                continue\n",
    "            counts = reported.groupby(\"year\")[\"county_id\"].nunique()\n",
    "            region_eligible[(name, m)] = bool((counts == N_COUNTIES).all())\n",
    "\n",
    "    rows = []\n",
    "    for (name, type_, year), g in county_df.groupby([\"name\", \"type\", \"year\"]):\n",
    "        row = {\"name\": name, \"type\": type_, \"year\": year, \"geography\": \"Region\"}\n",
    "        for m in ADDITIVE_METRICS:\n",
    "            present = g.loc[g[m].notna(), \"county_id\"].nunique() if m in g else 0\n",
    "            if region_eligible.get((name, m)) and present == N_COUNTIES:\n",
    "                row[m] = g[m].sum()\n",
    "            else:\n",
    "                row[m] = float(\"nan\")\n",
    "        rows.append(row)\n",
    "    region = pd.DataFrame(rows)\n",
    "    region[\"hhsz\"] = region[\"hhpop\"] / region[\"hh\"]\n",
    "    return region\n",
    "\n",
    "\n",
    "region_df = build_region(county_df)\n",
    "\n",
    "combined = pd.concat([county_df, region_df], ignore_index=True)\n",
    "\n",
    "# Keep only the columns the dashboard needs and tidy types.\n",
    "keep_cols = [\"year\", \"geography\", \"name\", \"type\"] + METRICS\n",
    "combined = combined[[c for c in keep_cols if c in combined.columns]].copy()\n",
    "combined[\"year\"] = combined[\"year\"].astype(int)\n",
    "combined = combined.sort_values([\"geography\", \"type\", \"name\", \"year\"]).reset_index(drop=True)\n",
    "\n",
    "# Export to Observable JS (runs client-side; data baked into the page).\n",
    "ojs_define(data=combined)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "61f1e584",
   "metadata": {},
   "source": [
    "## {.sidebar width=\"320px\"}\n",
    "\n",
    "```{ojs}\n",
    "viewof geography = Inputs.radio(geographies, {label: \"Geography\", value: \"Region\"})\n",
    "```\n",
    "\n",
    "```{ojs}\n",
    "viewof metric = Inputs.select(metrics, {label: \"Metric\", value: \"total_pop\", format: m => metricLabels[m]})\n",
    "```\n",
    "\n",
    "```{ojs}\n",
    "viewof selHistorical = Inputs.checkbox(\n",
    "  namesByType.get(\"Historical\") ?? [],\n",
    "  {label: \"Historical\", value: namesByType.get(\"Historical\") ?? []}\n",
    ")\n",
    "```\n",
    "\n",
    "```{ojs}\n",
    "viewof selForecast = Inputs.checkbox(\n",
    "  namesByType.get(\"Forecast\") ?? [],\n",
    "  {label: \"Forecast\", value: namesByType.get(\"Forecast\") ?? []}\n",
    ")\n",
    "```\n",
    "\n",
    "```{ojs}\n",
    "viewof selGrowthTarget = Inputs.checkbox(\n",
    "  namesByType.get(\"Growth Target\") ?? [],\n",
    "  {label: \"Growth Target\", value: namesByType.get(\"Growth Target\") ?? []}\n",
    ")\n",
    "```\n",
    "\n",
    "<!-- Hidden helper definitions (no cards). -->\n",
    "\n",
    "```{ojs}\n",
    "//| output: false\n",
    "allData = transpose(data)\n",
    "```\n",
    "\n",
    "```{ojs}\n",
    "//| output: false\n",
    "countyOrder = [\"King County\", \"Kitsap County\", \"Pierce County\", \"Snohomish County\"]\n",
    "```\n",
    "\n",
    "```{ojs}\n",
    "//| output: false\n",
    "geographies = [\"Region\"].concat(countyOrder)\n",
    "```\n",
    "\n",
    "```{ojs}\n",
    "//| output: false\n",
    "metrics = [\"total_pop\", \"units\", \"hh\", \"hhpop\", \"hhsz\", \"gq\"]\n",
    "```\n",
    "\n",
    "```{ojs}\n",
    "//| output: false\n",
    "metricLabels = {\n",
    "  return {\n",
    "    total_pop: \"Total Population\",\n",
    "    units: \"Housing Units\",\n",
    "    hh: \"Households\",\n",
    "    hhpop: \"Household Population\",\n",
    "    hhsz: \"Household Size\",\n",
    "    gq: \"Group Quarters\"\n",
    "  };\n",
    "}\n",
    "```\n",
    "\n",
    "```{ojs}\n",
    "//| output: false\n",
    "typeOrder = [\"Historical\", \"Forecast\", \"Growth Target\"]\n",
    "```\n",
    "\n",
    "```{ojs}\n",
    "//| output: false\n",
    "// Names that actually have data for the current geography + metric. Under\n",
    "// \"Region\", partial-coverage sources have null region values and so drop out.\n",
    "availNames = new Set(\n",
    "  allData\n",
    "    .filter(d => d.geography === geography && d[metric] != null)\n",
    "    .map(d => d.name)\n",
    ")\n",
    "```\n",
    "\n",
    "```{ojs}\n",
    "//| output: false\n",
    "// Available names grouped by type, preserving the configured type order.\n",
    "namesByType = {\n",
    "  const m = new Map(typeOrder.map(t => [t, []]));\n",
    "  const seen = new Set();\n",
    "  for (const d of allData) {\n",
    "    if (!availNames.has(d.name) || seen.has(d.name)) continue;\n",
    "    seen.add(d.name);\n",
    "    if (!m.has(d.type)) m.set(d.type, []);\n",
    "    m.get(d.type).push(d.name);\n",
    "  }\n",
    "  for (const arr of m.values()) arr.sort();\n",
    "  return m;\n",
    "}\n",
    "```\n",
    "\n",
    "```{ojs}\n",
    "//| output: false\n",
    "selectedNames = new Set([...selHistorical, ...selForecast, ...selGrowthTarget])\n",
    "```\n",
    "\n",
    "```{ojs}\n",
    "//| output: false\n",
    "filtered = allData.filter(d =>\n",
    "  d.geography === geography &&\n",
    "  selectedNames.has(d.name) &&\n",
    "  d[metric] != null\n",
    ")\n",
    "```\n",
    "\n",
    "## Column\n",
    "\n",
    "### Row {height=\"58%\"}\n",
    "\n",
    "```{ojs}\n",
    "//| title: Forecast comparison\n",
    "Plot.plot({\n",
    "  marginLeft: 80,\n",
    "  marginRight: 20,\n",
    "  x: {label: \"Year\", tickFormat: \"d\"},\n",
    "  y: {label: metricLabels[metric], grid: true, nice: true},\n",
    "  color: {legend: true},\n",
    "  marks: [\n",
    "    Plot.ruleY([0], {stroke: \"#ddd\"}),\n",
    "    Plot.line(filtered, {x: \"year\", y: metric, stroke: \"name\", curve: \"linear\", strokeWidth: 1.8}),\n",
    "    Plot.dot(filtered, {x: \"year\", y: metric, stroke: \"name\", fill: \"white\", r: 2.2}),\n",
    "    Plot.tip(\n",
    "      filtered,\n",
    "      Plot.pointer({x: \"year\", y: metric, stroke: \"name\", channels: {name: \"name\", type: \"type\"}})\n",
    "    )\n",
    "  ]\n",
    "})\n",
    "```\n",
    "\n",
    "### Row {height=\"42%\"}\n",
    "\n",
    "```{ojs}\n",
    "//| title: Data table\n",
    "pivotRows = {\n",
    "  const years = Array.from(new Set(filtered.map(d => d.year))).sort((a, b) => a - b);\n",
    "  const byName = new Map();\n",
    "  for (const d of filtered) {\n",
    "    if (!byName.has(d.name)) byName.set(d.name, {Name: d.name, Type: d.type});\n",
    "    byName.get(d.name)[d.year] = d[metric];\n",
    "  }\n",
    "  return {years, rows: Array.from(byName.values())};\n",
    "}\n",
    "```\n",
    "\n",
    "```{ojs}\n",
    "//| output: false\n",
    "fmt = new Intl.NumberFormat(\"en-US\", {maximumFractionDigits: 2})\n",
    "```\n",
    "\n",
    "```{ojs}\n",
    "Inputs.table(\n",
    "  pivotRows.rows,\n",
    "  {\n",
    "    columns: [\"Name\", ...pivotRows.years],\n",
    "    header: Object.fromEntries(pivotRows.years.map(y => [y, String(y)])),\n",
    "    format: Object.fromEntries(\n",
    "      pivotRows.years.map(y => [y, v => v == null ? \"\" : fmt.format(v)])\n",
    "    ),\n",
    "    rows: 18\n",
    "  }\n",
    ")\n",
    "```"
   ]
  }
